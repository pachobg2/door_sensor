#pragma once

// Rename this file to config.h and adjust if needed.
// Unlike before v2.0.0, this file no longer holds WiFi/MQTT credentials or
// device identity -- those are configured at runtime via the built-in web
// setup portal (see runMaintenanceMode() in the .ino) and persisted in NVS,
// same system as temp_humidity_sensor_v4. What's left here is OTA password,
// hardware pins, battery calibration, and timing constants. Keep it out of
// git (see .gitignore) regardless -- in case you ever add something
// sensitive to it.

// ------------------------------------------------------------------
// OTA (ArduinoOTA, triggered remotely via the "OTA Update" MQTT switch —
// this device has no spare GPIO for a physical OTA button, see the .ino)
// ------------------------------------------------------------------
const char* OTA_PASSWORD    = "choose-an-ota-password";

// ------------------------------------------------------------------
// Setup portal
// ------------------------------------------------------------------
// Password for this device's own temporary setup WiFi network (e.g.
// "P@cho P.Door XXXX"). MUST be 8-63 characters -- that's a hard WPA2
// requirement, not just this library's preference. It's only broadcast
// while the portal is open, not during normal operation.
const char* AP_PASSWORD = "setup1234";
// How long the setup portal stays open before giving up and going back to
// sleep with whatever settings it already had.
const uint32_t PORTAL_TIMEOUT_SEC = 600; // 10 min

// ------------------------------------------------------------------
// Network debug session (Debug Mode -- see runDebugSession() in the .ino)
// ------------------------------------------------------------------
// Raw TCP port for the network serial monitor -- 23 is the real telnet
// port, so `telnet <ip>` works with no port argument.
const uint16_t NETWORK_DEBUG_PORT = 23;
// Debug Mode keeps the device fully awake (no deep sleep) the whole time
// it's on, so this bounds how long a forgotten HA toggle can drain the
// battery before the device auto-reverts to normal operation on its own.
const uint32_t DEBUG_SESSION_TIMEOUT_MS = 30UL * 60 * 1000UL; // 30 min

// ------------------------------------------------------------------
// Device identity (firmware facts, not user settings -- device ID/name are
// configured at runtime via the setup portal instead)
// ------------------------------------------------------------------
const char* DEVICE_MANUFACTURER = "P@cho";
const char* DEVICE_MODEL        = "P.Door";
const char* DEVICE_HW_VERSION   = "1.1";
const char* FIRMWARE_VERSION    = "1.0.0";

// ------------------------------------------------------------------
// Hardware
// ------------------------------------------------------------------
const gpio_num_t REED_PIN   = GPIO_NUM_4;   // RTC-capable, NOT a strapping pin
const gpio_num_t BATT_PIN   = GPIO_NUM_1;   // ADC-capable

// Battery divider ratio: if using two equal resistors, actual = reading * 2.0
const float BATT_DIVIDER_RATIO = 2.0f;

// Piecewise-linear correction from raw divider-derived voltage to actual
// voltage, for this specific board's ADC/divider error — same mechanism as
// temp_humidity_sensor's BATT_CAL. Defaults to identity (no correction):
// measure this board's own raw vs. actual voltage (multimeter on the
// battery, compare against the raw value logged over serial) at a few
// points and replace these before trusting precise battery %.
struct CalPoint { float raw; float actual; };
const CalPoint BATT_CAL[] = {
  {3.00f, 3.00f}, {4.20f, 4.20f},
};
const int BATT_CAL_POINTS = sizeof(BATT_CAL) / sizeof(BATT_CAL[0]);
const float BATTERY_LOW_THRESHOLD_PCT = 15.0f;

// ------------------------------------------------------------------
// Timing
// ------------------------------------------------------------------
const uint64_t HEARTBEAT_INTERVAL_US = 12ULL * 60 * 60 * 1000000ULL; // 12 hours
const uint32_t WIFI_CONNECT_TIMEOUT_MS = 8000;
const uint32_t MQTT_CONNECT_TIMEOUT_MS = 5000;   // per attempt
const uint32_t MQTT_CONNECT_ATTEMPTS   = 3;
const uint32_t MQTT_PUBLISH_ACK_TIMEOUT_MS = 2000; // per attempt
const uint32_t MQTT_PUBLISH_ATTEMPTS   = 3;
// Fixed (unconditional) delay after the clean disconnect() call, giving
// the library's background task real wall-clock time to actually send the
// DISCONNECT packet before WiFi gets torn down and the device sleeps. Too
// short and the broker sometimes sees an abrupt drop instead of a clean
// one, firing the Last Will (silent on this side -- shows up only as a
// brief "unavailable" gap in HA until the next wake corrects it). This is
// NOT a poll on mqttClient.connected() -- that flag isn't a reliable
// "has it actually sent yet" signal, so don't try to shortcut this wait.
const uint32_t MQTT_DISCONNECT_DELAY_MS = 400;
// How long to linger, still connected and polling the reed switch, after
// the main work of a cycle is done and before starting the MQTT/WiFi
// teardown -- catches a follow-up transition that happens shortly after
// the main publish while there's still a live connection to report it on,
// rather than only picking it up (uncounted-as-its-own-event) via the
// disconnect-delay polling below or the next wake entirely. A few extra
// seconds occasionally, not continuous wake -- cheap in battery terms.
const uint32_t DOOR_LINGER_MS = 3000; // 3s
const uint32_t DEBOUNCE_SETTLE_MS      = 50;
// A candidate door-state transition must hold for this many consecutive
// samples (each DEBOUNCE_SETTLE_MS apart) before it's trusted -- rejects
// switch bounce and RF pickup from the WiFi radio's own TX bursts landing
// on this GPIO. Raise DOOR_DEBOUNCE_SAMPLES if false OPEN/CLOSED readings
// keep happening; DOOR_DEBOUNCE_MAX_ATTEMPTS bounds the worst case so a
// genuinely noisy line doesn't stall the device forever.
const int DOOR_DEBOUNCE_SAMPLES       = 4;
const int DOOR_DEBOUNCE_MAX_ATTEMPTS  = 12;
const uint32_t OTA_WINDOW_MS           = 5UL * 60 * 1000UL; // how long to stay awake for OTA once triggered
const uint32_t OTA_SUBSCRIBE_WAIT_MS   = 1000; // time to wait for a retained OTA command after subscribing

// Force-restarts the device if it's ever awake longer than this — a hang,
// an unexpected infinite loop, a stuck library call. Independent of
// everything else in the sketch: guarantees the device eventually resets
// rather than draining the battery all night awake. Re-armed with a longer
// deadline while an OTA window is actually in progress (see the .ino).
const uint32_t AWAKE_WATCHDOG_TIMEOUT_MS = 90UL * 1000UL;

// How long Home Assistant keeps showing a sensor's last value before
// marking it "unavailable" if this device stops reporting. Set to a
// multiple of the heartbeat interval so a normal gap between wakes never
// trips it, but a dead battery eventually shows up as unavailable instead
// of a door state frozen forever at its last value.
const uint32_t EXPIRE_AFTER_SEC = (uint32_t)(HEARTBEAT_INTERVAL_US / 1000000ULL) * 3;

// ------------------------------------------------------------------
// Time (used only to record a real calendar date for the last-full-charge
// diagnostic -- see updateAndGetLastFullChargeDate() in the .ino)
// ------------------------------------------------------------------
const char* NTP_SERVER = "pool.ntp.org";
const char* TZ_STRING  = "EET-2EEST,M3.5.0/3,M10.5.0/4"; // Bulgaria, matches energy_meter
const uint32_t NTP_SYNC_TIMEOUT_MS = 5000;
const uint32_t NTP_RESYNC_EVERY_N_BOOTS = 6; // small clock drift between resyncs won't shift the day

// DEBUG: set true while bench-testing to (a) give Serial Monitor time to
// attach before anything happens, and (b) skip deep sleep entirely so the
// board stays connected and loop() keeps printing status. Set back to
// false before deploying on battery, or it'll drain fast.
const bool DEBUG_MODE = false;
const uint32_t DEBUG_BOOT_DELAY_MS = 5000;
